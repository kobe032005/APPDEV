@page "/"
@inject StudentApiClient Api

<PageTitle>Student Dashboard</PageTitle>

<div class="dashboard-shell">
	<header class="dashboard-header">
		<div>
			<p class="eyebrow">College administration</p>
			<h1>Students <span class="count-badge">@Students.Count</span></h1>
		</div>
		<button class="avatar" type="button">AD</button>
	</header>

	<div class="toolbar">
		<input @bind="SearchTerm" @bind:event="oninput" placeholder="Search students" aria-label="Search students" />
		<select @bind="StatusFilter" aria-label="Filter by status">
			<option>All</option><option>Active</option><option>On Leave</option><option>Graduated</option><option>Inactive</option>
		</select>
		<button class="primary" @onclick="OpenNew">+ Add a student</button>
	</div>

	<section class="overview-grid">
		<article class="stat blue"><span>Total students</span><strong>@Students.Count</strong><small>All records</small></article>
		<article class="stat green"><span>Active</span><strong>@CountStatus("Active")</strong><small>Currently enrolled</small></article>
		<article class="stat yellow"><span>On leave</span><strong>@CountStatus("On Leave")</strong><small>Needs follow-up</small></article>
		<article class="stat pink"><span>Graduated</span><strong>@CountStatus("Graduated")</strong><small>Completed studies</small></article>
	</section>

	@if (EditingStudent is not null)
	{
		<EditForm Model="EditingStudent" OnValidSubmit="SaveStudent" class="student-form">
			<div class="form-heading"><div><p class="eyebrow">Student profile</p><h2>@(EditingStudent.Id == 0 ? "Add student" : "Edit student")</h2></div><button type="button" @onclick="CloseForm">&times;</button></div>
			<fieldset><legend>1. Student profile</legend><div class="form-grid">
				<InputText @bind-Value="EditingStudent.StudentId" placeholder="Student ID" />
				<InputText @bind-Value="EditingStudent.Name" placeholder="Full name" />
				<InputText @bind-Value="EditingStudent.Email" placeholder="Email address" />
				<InputText @bind-Value="EditingStudent.Phone" placeholder="Phone number" />
			</div></fieldset>
			<fieldset><legend>2. Academic details</legend><div class="form-grid">
				<InputText @bind-Value="EditingStudent.Course" placeholder="Course name" />
				<InputText @bind-Value="EditingStudent.CourseCode" placeholder="Course code" />
				<InputText @bind-Value="EditingStudent.YearLevel" placeholder="Year level" />
				<InputText @bind-Value="EditingStudent.Section" placeholder="Section" />
			</div></fieldset>
			<fieldset><legend>3. Enrollment</legend><div class="form-grid">
				<InputDate @bind-Value="EditingStudent.EnrollmentDate" />
				<InputSelect @bind-Value="EditingStudent.Status"><option>Active</option><option>On Leave</option><option>Graduated</option><option>Inactive</option></InputSelect>
				<InputText @bind-Value="EditingStudent.Address" placeholder="Address" class="wide" />
			</div></fieldset>
			<div class="form-actions"><button class="primary" type="submit">Save Student</button><button type="button" @onclick="CloseForm">Cancel</button></div>
		</EditForm>
	}

	<section class="directory">
		<div class="section-heading"><div><p class="eyebrow">All enrolled learners</p><h2>Student directory</h2></div><span>@FilteredStudents.Count students</span></div>
		<div class="table-wrap"><table><thead><tr><th>Student</th><th>Course</th><th>Year / Section</th><th>Status</th><th>Actions</th></tr></thead><tbody>
		@foreach (var student in FilteredStudents)
		{
			<tr><td><strong>@student.Name</strong><small>@student.Email</small></td><td>@student.Course<br /><small>@student.CourseCode</small></td><td>@student.YearLevel / @student.Section</td><td><span class="status @student.Status.ToLowerInvariant().Replace(" ", "-")">@student.Status</span></td><td><button class="link" @onclick="() => OpenEdit(student)">Edit</button><button class="danger" @onclick="() => Remove(student)">Delete</button></td></tr>
		}
		</tbody></table></div>
	</section>
</div>

@code {
	private List<Student> Students = [];
	private Student? EditingStudent;
	private string SearchTerm = string.Empty;
	private string StatusFilter = "All";
	private List<Student> FilteredStudents => Students.Where(student => (StatusFilter == "All" || student.Status == StatusFilter) && ($"{student.Name} {student.StudentId} {student.Email} {student.Course}".Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))).ToList();

	protected override async Task OnInitializedAsync() => Students = await Api.GetStudentsAsync();
	private int CountStatus(string status) => Students.Count(student => student.Status == status);
	private void OpenNew() => EditingStudent = new Student { EnrollmentDate = DateOnly.FromDateTime(DateTime.Today), Status = "Active" };
	private void OpenEdit(Student student) => EditingStudent = new Student { Id = student.Id, StudentId = student.StudentId, Name = student.Name, Email = student.Email, Phone = student.Phone, Course = student.Course, CourseCode = student.CourseCode, YearLevel = student.YearLevel, Section = student.Section, EnrollmentDate = student.EnrollmentDate, Status = student.Status, Address = student.Address };
	private void CloseForm() => EditingStudent = null;
	private async Task SaveStudent() { if (EditingStudent!.Id == 0) await Api.CreateAsync(EditingStudent); else await Api.UpdateAsync(EditingStudent); Students = await Api.GetStudentsAsync(); EditingStudent = null; }
	private async Task Remove(Student student) { await Api.DeleteAsync(student.Id); Students = await Api.GetStudentsAsync(); }
}
