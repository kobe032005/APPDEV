@page "/"
@inject StudentApiClient Api

<PageTitle>Student Dashboard</PageTitle>
<main class="dashboard">
	<p class="eyebrow">College administration</p>
	<h1>Student dashboard</h1>
	<section class="stats"><div><span>Total students</span><strong>@Students.Count</strong></div><div><span>Active</span><strong>@Students.Count(student => student.Status == "Active")</strong></div></section>
	<section class="panel"><div class="panel-heading"><h2>Student directory</h2><button @onclick="LoadStudents">Refresh</button></div>
		@if (LoadError is not null) { <p class="error">@LoadError</p> }
		else if (Students.Count == 0) { <p class="muted">No students found.</p> }
		else { <div class="student-list">@foreach (var student in Students) { <article><div><strong>@student.Name</strong><small>@student.StudentId · @student.Course</small></div><span class="status">@student.Status</span></article> }</div> }
	</section>
</main>

@code {
	private List<Student> Students = [];
	private string? LoadError;

	protected override async Task OnInitializedAsync() => await LoadStudents();

	private async Task LoadStudents()
	{
		try { LoadError = null; Students = await Api.GetStudentsAsync(); }
		catch (HttpRequestException) { LoadError = "Start the StudentRecords API to load students."; }
	}
}
